# Khatt environment — copy to .env and adjust. No secrets are required.

# --- Paths ---
KHATT_DATA_DIR=data
KHATT_PARAMS=config/params.yaml
KHATT_SCENARIOS_DIR=scenarios
KHATT_LOG_DIR=logs

# --- r5py / Java (pipeline/08_baseline_matrix.py) ---
# r5py only reads --max-memory from argv/config file, so 08 must forward this:
#   sys.argv += ["--max-memory", os.environ["R5PY_MAX_MEMORY"]]  (before `import r5py`)
JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-25.jdk/Contents/Home
R5PY_MAX_MEMORY=10G
# Abort r5py and switch to the scipy fallback after this many minutes (CLAUDE.md §6)
KHATT_BASELINE_TIMEOUT_MIN=90

# --- Numba ---
# Threads for the parallel overlay; unset = all cores
# NUMBA_NUM_THREADS=8
NUMBA_CACHE_DIR=.numba_cache

# --- API ---
KHATT_API_HOST=127.0.0.1
KHATT_API_PORT=8000
# Comma-separated origins allowed by CORS (Vite dev server)
KHATT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Web (Vite only exposes VITE_-prefixed vars; mirror in web/.env if needed) ---
VITE_API_URL=http://127.0.0.1:8000
